# AegisAPI environment variables
#
# Copy to .env for local reference only. AegisAPI does NOT read .env files; it
# reads these variables from the real process environment. They override
# config.toml and are themselves overridden by command-line options.
#
# Never put API keys, tokens, passwords, or session cookies in this file or in
# config.toml. Credentials for future assessment modules will be supplied per
# run, not stored on disk.

# Relocate the whole workspace (config.toml, logs, reports, evidence).
# Default on Windows: %APPDATA%\AegisAPI
AEGISAPI_HOME=

# Use a specific configuration file instead of <workspace>\config.toml.
AEGISAPI_CONFIG=

# Console log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
AEGISAPI_LOG_LEVEL=INFO

# Default per-request timeout in seconds, for future HTTP modules.
AEGISAPI_REQUEST_TIMEOUT=10

# Default ceiling on concurrent requests, for future HTTP modules.
AEGISAPI_MAX_CONCURRENCY=4

# Default report format: json, html, or pdf.
AEGISAPI_REPORT_FORMAT=json

# Scope enforcement. Leave enabled unless you have a very good reason.
AEGISAPI_ENFORCE_SCOPE=true

# Comma-separated bare hostnames you are authorised to assess.
AEGISAPI_ALLOWED_HOSTS=
